{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Binge: Run local website",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "BINGE_DEV_PORT": "5001",
        "BINGE_RELOAD": "0"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on (http://127\\.0\\.0\\.1:[0-9]+)",
        "uriFormat": "%s"
      }
    }
  ]
}
