# Render sets PORT and RENDER_EXTERNAL_URL automatically.
BINGE_ENV=production
BINGE_HOST=0.0.0.0
BINGE_DATA_DIR=/var/data/binge
BINGE_STORAGE_LIMIT_GB=8
BINGE_SHOW_DEMO=0
# Set this privately in Render's environment panel; never commit a real password.
BINGE_ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
# Optional when using a custom domain:
# BINGE_PUBLIC_URL=https://your-domain.example
